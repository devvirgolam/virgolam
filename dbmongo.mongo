// blog.model.js (Mongoose)
const Blog = new Schema({
  title: { type: String, required: true },
  slug: { type: String, index: true, unique: true },
  category: { type: Schema.Types.ObjectId, ref: 'BlogCategory' },
  content: String,           // HTML or Markdown
  excerpt: String,
  bannerImage: String,
  images: [String],
  seo: {
    title: String,
    description: String,
    keywords: [String]
  },
  publishedAt: Date,
  status: { type: String, enum: ['draft','published','archived'], default: 'draft' },
  createdBy: { type: String }, // user id
  createdAt: { type: Date, default: Date.now },
  updatedAt: Date
});

// contact.model.js
const Contact = new Schema({
  name: String, email: String, phoneNumber: String, message: String,
  city: String, state: String, country: String, pincode: String,
  createdAt: { type: Date, default: Date.now },
  notified: { type: Boolean, default: false }
});

// career.model.js
const CareerSubmission = new Schema({
  fullName: String, mobileNumber: String, age: Number, email: String,
  resumeUrl: String, message: String, appliedFor: String,
  createdAt: { type: Date, default: Date.now }
});
